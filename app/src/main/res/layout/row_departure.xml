<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Train suivant d'un train supprimé, affiché juste en dessous -->
    <TextView
        android:id="@+id/replaces"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:text="↳"
        android:textColor="@color/text_dim"
        android:textSize="22sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/badge_bg"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:minWidth="46dp"
        android:paddingHorizontal="6dp"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/destination"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/last"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/badge_bg"
        android:backgroundTint="@color/late"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.06"
        android:paddingHorizontal="5dp"
        android:paddingVertical="1dp"
        android:text="DERNIER"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:maxLines="1"
        android:textColor="@color/text_faint"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/travelMode"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="12dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="end"
        android:minWidth="72dp"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="end"
        android:minWidth="62dp"
        android:textColor="@color/text"
        android:textSize="20sp" />
</LinearLayout>
